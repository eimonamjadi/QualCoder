# Copy to .env (never commit .env) or export these in your shell.
# Claude is the default provider.
ANTHROPIC_API_KEY=sk-ant-...
# QUALCODE_CLAUDE_MODEL=claude-opus-5-5
# QUALCODE_CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max
# QUALCODE_CLAUDE_FALLBACKS=on           # server-side refusal fallback; 'off' to disable

# Optional: OpenAI
# OPENAI_API_KEY=sk-...
# QUALCODE_OPENAI_MODEL=your-model-name

# Optional: local model via Ollama (https://ollama.com), e.g. `ollama pull llama3.1`
# OLLAMA_HOST=http://localhost:11434
# QUALCODE_OLLAMA_MODEL=llama3.1

# Where the SQLite database lives
# QUALCODE_DB=./data/qualcode.db
